{
  "name": "iseeku-mobile",
  "version": "1.0.0",
  "description": "Capacitor shell that wraps the ISeekU React build for Android and iOS",
  "private": true,
  "scripts": {
    "cap": "cap",
    "add:android": "npx cap add android",
    "add:ios": "npx cap add ios",
    "sync": "npx cap sync",
    "run:android": "npx cap run android",
    "run:ios": "npx cap run ios",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
