# Dependencies
node_modules/

# Build outputs
build/
dist/

# Electron session data (WhatsApp login, Telegram session)
data/
.wwebjs_cache/
.wwebjs_auth/

# Bundled Chromium (downloaded via scripts/download-chrome.js, not committed)
puppeteer_cache/

# Server probe reports — these carry the Owner's own account data (bound JID,
# Contact List size, Group names) and must never be committed. Run
# tools/probe-server.js locally and read the report locally.
server-probe.json
*-probe.json

# Environment / secrets
.env
.env.local
.env.production
.env.development
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
*.log
npm-debug.log*

# electron-builder cache
electron-builder-cache/

# Playwright / test artifacts
test-results/
playwright-report/
